{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/nglmercer/commad-tiktok-mod/schemas/function.schema.json",
  "title": "TikTokMinecraft function",
  "description": "A function file in plugins/TikTokMinecraft/functions/.",
  "type": "object",
  "required": ["steps"],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9_.-]+:[a-z0-9_/.-]+$"
    },
    "description": { "type": "string", "maxLength": 512 },
    "parameters": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/parameter" }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/step" }
    }
  },
  "$defs": {
    "parameter": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "string",
            "integer",
            "number",
            "boolean",
            "entity",
            "player",
            "selector",
            "position",
            "enum",
            "resource_location"
          ]
        },
        "required": { "type": "boolean" },
        "default": { "type": ["string", "number", "boolean"] },
        "min": { "type": "number" },
        "max": { "type": "number" },
        "values": { "type": "array", "items": { "type": "string" } },
        "description": { "type": "string", "maxLength": 512 }
      },
      "additionalProperties": false
    },
    "step": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "command",
            "summon",
            "title",
            "sound",
            "particle",
            "repeat",
            "delay",
            "function",
            "if"
          ]
        }
      },
      "additionalProperties": true
    }
  }
}
